{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "ES2022"],
        "allowJs": false,
        "noEmit": true,
        "declaration": false,
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
    "exclude": ["node_modules", ".next", "dist"]
}
