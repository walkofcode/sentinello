{
    "name": "@sentinello/feeds",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "Advisory feed downloaders, normalizers, and freshness checks (OSV, gemnasium). Storage-agnostic by design so the CLI can cache without SQLite.",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@sentinello/core": "workspace:*",
        "@sentinello/versions": "workspace:*",
        "js-yaml": "4.3.1",
        "unzipper": "0.12.3"
    },
    "devDependencies": {
        "@types/js-yaml": "4.0.9",
        "@types/node": "25.6.0",
        "@types/semver": "7.7.1",
        "@types/unzipper": "0.10.11",
        "semver": "7.7.4"
    }
}
